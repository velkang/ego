{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jovva-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jovva",
      "database_id": "2e1bf7a4-da03-4aea-873e-b76ba74a0a16",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ORIGIN": "https://jovva-web.velikanghost.workers.dev",
    "ARC_RPC_URL": "https://rpc.testnet.arc.io",
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "504200201",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "CLAIM_LIMIT",
      "namespace_id": "504200202",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
}
